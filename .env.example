# STEM QUEST environment variables (example / template)
# Copy this file to `.env` and fill in real values when Supabase is provisioned.
# NEVER commit the real `.env` file. No secrets belong in frontend code.

# Supabase project (public, non-secret) values
# VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Backend / Node API base URL (used once the API layer is introduced)
# VITE_API_BASE_URL=http://localhost:3001/api

# ----------------------------------------------------------------------------
# Server-only Supabase credentials (Task 5.4 — production integration).
# These drive `npm run api:production` and the live smoke test. They MUST stay
# server-side: NEVER prefix with VITE_, never import them into client code,
# and never commit the real `.env` file (`.gitignore` keeps it out).
# Copy to `.env` and fill in real values.
# ----------------------------------------------------------------------------
# Public project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://fmauqixvdpdgrghuapfs.supabase.co
# Service-role key (Secret; Supabase Dashboard → Project Settings → API).
# The service role bypasses RLS (D-027) and is the trusted gameplay write path.
SUPABASE_SERVICE_ROLE_KEY=<paste-your-service-role-key-here>

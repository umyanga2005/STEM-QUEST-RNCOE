{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/fill-complete/payload.schema.json",
  "$comment": "STEM QUEST Fill/Complete payload (Task 3.2). Production activity: type into structured blanks. NOT a disguised MCQ (no options).",
  "type": "object",
  "required": ["schemaVersion", "template", "blanks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Text containing ___ placeholders. One placeholder per blank, in order."
    },
    "blanks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "type": {
            "type": "string",
            "enum": ["text", "number", "expression"],
            "description": "text = normalized exact match; number = numeric tolerance; expression = normalized string forms."
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "prefix": { "type": "string", "maxLength": 40 },
          "suffix": { "type": "string", "maxLength": 40 },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 120, "default": 24 }
        },
        "additionalProperties": false
      }
    },
    "keypad": {
      "type": "string",
      "enum": ["default", "numeric", "text"],
      "default": "default"
    }
  },
  "additionalProperties": false
}
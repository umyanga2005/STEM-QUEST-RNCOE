{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/image-interaction/payload.schema.json",
  "$comment": "STEM QUEST Image Interaction payload (Task 3.2). Normalized % coordinates so layouts survive responsive resizing.",
  "type": "object",
  "required": ["schemaVersion", "image", "imageWidth", "imageHeight", "mode", "hotspots"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "image": { "$ref": "https://stem-quest.dev/schemas/common/media.schema.json" },
    "imageWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "imageHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "mode": { "enum": ["tap", "label"] },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "x", "y"],
        "properties": {
          "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "x": { "type": "number", "minimum": 0, "maximum": 100, "description": "Center x as % of image width." },
          "y": { "type": "number", "minimum": 0, "maximum": 100, "description": "Center y as % of image height." },
          "shape": { "enum": ["circle", "rect"], "default": "circle" },
          "radius": { "type": "number", "minimum": 1, "maximum": 50, "description": "Hit radius as % of image width (circle)." },
          "width": { "type": "number", "minimum": 1, "maximum": 100, "description": "Hit width as % of image width (rect)." },
          "height": { "type": "number", "minimum": 1, "maximum": 100, "description": "Hit height as % of image height (rect)." },
          "ariaLabel": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "description": "Required when mode=label: draggable labels placed onto hotspots.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "text": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
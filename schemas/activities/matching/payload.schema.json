{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/matching/payload.schema.json",
  "$comment": "STEM QUEST Matching payload (Task 3.2). Left/right cards to pair; distractors optional. Not MCQ: pair-building.",
  "type": "object",
  "required": ["schemaVersion", "leftItems", "rightItems"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "leftItems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/card" }
    },
    "rightItems": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/card" }
    },
    "distractors": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "description": "Right-side cards that match nothing on the left.",
      "items": { "$ref": "#/$defs/card" }
    },
    "shuffle": { "type": "boolean", "default": true }
  },
  "additionalProperties": false,
  "$defs": {
    "card": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
        "text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "image": { "$ref": "https://stem-quest.dev/schemas/common/media.schema.json" },
        "ariaLabel": { "type": "string", "maxLength": 160 }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["image"] }
      ],
      "additionalProperties": false
    }
  }
}
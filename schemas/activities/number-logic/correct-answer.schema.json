{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/number-logic/correct-answer.schema.json",
  "$comment": "STEM QUEST Number/Logic Challenge correct answer (Task 3.2). Explicit numeric comparison with tolerance to avoid float errors. Server-only.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "enum": ["exact", "tolerance", "range", "fraction", "percent", "sequence", "accepted-set"]
    },
    "value": { "type": "number", "description": "exact/tolerance/percent central value." },
    "tolerance": { "type": "number", "minimum": 0, "default": 0, "description": "Absolute tolerance; equality uses |a - value| <= tolerance (float-safe)." },
    "min": { "type": "number", "description": "range lower bound (inclusive)." },
    "max": { "type": "number", "description": "range upper bound (inclusive)." },
    "numerator": { "type": "number", "description": "fraction numerator; equivalents accepted via lowest-term normalization." },
    "denominator": { "type": "number", "exclusiveMinimum": 0, "description": "fraction denominator." },
    "values": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "description": "sequence: expected element values; compared element-wise with tolerance.",
      "items": { "type": "number" }
    },
    "accepted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "accepted-set: normalized string forms (e.g. [\"x^2\",\"x*x\"]).",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "parts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "description": "Multi-step: per-part answer specs enabling per-part partial credit.",
      "items": {
        "type": "object",
        "required": ["partId", "type"],
        "properties": {
          "partId": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "type": {
            "enum": ["exact", "tolerance", "range", "fraction", "percent", "sequence", "accepted-set"]
          },
          "value": { "type": "number" },
          "tolerance": { "type": "number", "minimum": 0, "default": 0 },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "numerator": { "type": "number" },
          "denominator": { "type": "number", "exclusiveMinimum": 0 },
          "values": {
            "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "number" }
          },
          "accepted": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "exact" } }, "required": ["type"] },
      "then": { "required": ["value"] }
    },
    {
      "if": { "properties": { "type": { "const": "tolerance" } }, "required": ["type"] },
      "then": { "required": ["value", "tolerance"] }
    },
    {
      "if": { "properties": { "type": { "const": "range" } }, "required": ["type"] },
      "then": { "required": ["min", "max"] }
    },
    {
      "if": { "properties": { "type": { "const": "fraction" } }, "required": ["type"] },
      "then": { "required": ["numerator", "denominator"] }
    },
    {
      "if": { "properties": { "type": { "const": "percent" } }, "required": ["type"] },
      "then": { "required": ["value"] }
    },
    {
      "if": { "properties": { "type": { "const": "sequence" } }, "required": ["type"] },
      "then": { "required": ["values"] }
    },
    {
      "if": { "properties": { "type": { "const": "accepted-set" } }, "required": ["type"] },
      "then": { "required": ["accepted"] }
    }
  ],
  "additionalProperties": false
}
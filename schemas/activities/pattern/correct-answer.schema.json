{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/pattern/correct-answer.schema.json",
  "$comment": "STEM QUEST Pattern correct answer (Task 3.2). Acceptable solution rules (multiple valid solutions explicitly supported). Server-only.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["candidate", "numeric", "text"] },
    "rule": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Human-readable rule description shown in feedback." },
    "acceptableIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "description": "type=candidate: acceptable candidate ids (>=1; multiple valid solutions allowed).",
      "items": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" }
    },
    "value": { "type": "number", "description": "type=numeric: central expected value." },
    "tolerance": { "type": "number", "minimum": 0, "default": 0 },
    "min": { "type": "number", "description": "type=numeric: accepted range lower bound." },
    "max": { "type": "number", "description": "type=numeric: accepted range upper bound." },
    "accepted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "type=text: accepted normalized strings.",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "candidate" } }, "required": ["type"] },
      "then": { "required": ["acceptableIds"] }
    },
    {
      "if": { "properties": { "type": { "const": "numeric" } }, "required": ["type"] },
      "then": {
        "oneOf": [
          { "required": ["value"] },
          { "required": ["min", "max"] }
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
      "then": { "required": ["accepted"] }
    }
  ],
  "additionalProperties": false
}
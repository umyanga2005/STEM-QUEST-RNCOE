{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/scenario/correct-answer.schema.json",
  "$comment": "STEM QUEST Scenario Challenge correct answer (Task 3.2). Optimal path + acceptable alternatives per decision. Server-only.",
  "type": "object",
  "required": ["optimalPath"],
  "properties": {
    "optimalPath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["decisionId", "optionId"],
        "properties": {
          "decisionId": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "optionId": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" }
        },
        "additionalProperties": false
      }
    },
    "acceptableOptions": {
      "type": "object",
      "description": "Optional alternatives per decision id: list of acceptable option ids (in addition to the optimal one).",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" }
      }
    }
  },
  "additionalProperties": false
}
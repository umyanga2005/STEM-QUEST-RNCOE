{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stem-quest.dev/schemas/activities/sorting/payload.schema.json",
  "$comment": "STEM QUEST Sorting payload (Task 3.2). Classify items into categories. Not MCQ.",
  "type": "object",
  "required": ["schemaVersion", "items", "categories"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "image": { "$ref": "https://stem-quest.dev/schemas/common/media.schema.json" },
          "ariaLabel": { "type": "string", "maxLength": 160 }
        },
        "anyOf": [
          { "required": ["label"] },
          { "required": ["image"] }
        ],
        "additionalProperties": false
      }
    },
    "categories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "https://stem-quest.dev/schemas/common/ids.schema.json" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "image": { "$ref": "https://stem-quest.dev/schemas/common/media.schema.json" },
          "ariaLabel": { "type": "string", "maxLength": 160 }
        },
        "anyOf": [
          { "required": ["label"] },
          { "required": ["image"] }
        ],
        "additionalProperties": false
      }
    },
    "shuffle": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}